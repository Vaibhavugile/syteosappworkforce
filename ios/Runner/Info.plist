<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">

<plist version="1.0">
<dict>

	<!-- ============================================================
	     BASIC APP INFORMATION
	     ============================================================ -->

	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>

	<key>CFBundleDisplayName</key>
	<string>SyteosLabs</string>

	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>

	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>

	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>

	<key>CFBundleName</key>
	<string>SyteosLabs</string>

	<key>CFBundlePackageType</key>
	<string>APPL</string>

	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>

	<key>CFBundleSignature</key>
	<string>????</string>

	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>

	<key>LSRequiresIPhoneOS</key>
	<true/>


	<!-- ============================================================
	     LOCATION PERMISSIONS
	     ============================================================ -->

	<!--
	     Used for attendance/location verification,
	     sales visits and current location.
	-->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>SyteosLabs uses your location to verify attendance, record business visits, and provide location-based features.</string>

	<!--
	     Include this only if the app actually requests
	     background/Always location.
	-->
	<!--
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>SyteosLabs uses your location to support location-based business activities when required.</string>
	-->


	<!-- ============================================================
	     CAMERA
	     ============================================================ -->

	<!--
	     Used when the user takes attendance/visit proof photos
	     or captures other business-related images.
	-->
	<key>NSCameraUsageDescription</key>
	<string>SyteosLabs needs camera access to capture attendance, visit, and work-related photos.</string>


	<!-- ============================================================
	     PHOTO LIBRARY
	     ============================================================ -->

	<!-- Read/select photos from the device -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>SyteosLabs needs photo library access so you can select images for attendance, visits, tasks, and business records.</string>

	<!-- Save photos to the device -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>SyteosLabs needs permission to save photos to your photo library when requested.</string>


	<!-- ============================================================
	     MICROPHONE
	     ============================================================ -->

	<!--
	     ONLY keep this if your app actually records audio/video
	     using the microphone.
	-->
	<!--
	<key>NSMicrophoneUsageDescription</key>
	<string>SyteosLabs needs microphone access when recording work-related media.</string>
	-->


	<!-- ============================================================
	     NOTIFICATIONS
	     ============================================================ -->

	<!-- Firebase Cloud Messaging / APNs -->
	<key>FirebaseAppDelegateProxyEnabled</key>
	<true/>


	<!-- ============================================================
	     GOOGLE MAPS
	     ============================================================ -->

	<!--
	     Google Maps API key.

	     IMPORTANT:
	     Replace YOUR_IOS_GOOGLE_MAPS_API_KEY with the iOS
	     restricted API key from Google Cloud Console.
	-->
	<key>GMSApiKey</key>
	<string>AIzaSyAsHkvRLLcGhLuVLeFTK0nKP71Uk2CI2oY</string>


	<!-- ============================================================
	     LAUNCH SCREEN
	     ============================================================ -->

	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>

	<key>UIMainStoryboardFile</key>
	<string>Main</string>


	<!-- ============================================================
	     SUPPORTED ORIENTATIONS - IPHONE
	     ============================================================ -->

	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>


	<!-- ============================================================
	     SUPPORTED ORIENTATIONS - IPAD
	     ============================================================ -->

	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>


	<!-- ============================================================
	     FLUTTER
	     ============================================================ -->

	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>

	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>


	<!-- ============================================================
	     FILE SHARING / DOCUMENTS
	     ============================================================ -->

	<key>UIFileSharingEnabled</key>
	<true/>

	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

</dict>
</plist>